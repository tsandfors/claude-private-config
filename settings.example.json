{
  "env": {
    "CLAUDE_CODE_USE_VERTEX": "1",
    "CLOUD_ML_REGION": "global",
    "ANTHROPIC_VERTEX_PROJECT_ID": "<gcp-projekt-id>",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "theme": "dark",
  "claudeMdExcludes": [
    "<absolut sökväg till jobbets ~/.claude/CLAUDE.md>"
  ],
  "autoMemoryDirectory": "~/.claude-private/memory",
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude-private/bin/statusline.sh\"",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude-private/bin/session-start-orientation.sh\""
          }
        ]
      }
    ]
  }
}
